<Window x:Class="IssueDrop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IssueDrop settings" Width="480" Height="430" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="IssueDrop stays out of the way until you need it." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,24,0,0">
      <TextBlock Text="Global shortcut" FontWeight="SemiBold"/>
      <TextBox x:Name="HotkeyBox" Style="{StaticResource ComposerTextBox}" Background="{DynamicResource InputBackgroundBrush}" Padding="10,8" Margin="0,7,0,0"
               PreviewKeyDown="HotkeyBox_PreviewKeyDown" IsReadOnly="True" ToolTip="Click and press a shortcut"/>
      <TextBlock Text="Click the field, then press the key combination you want." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="1,4,0,16"/>

      <TextBlock Text="Appearance" FontWeight="SemiBold"/>
      <ComboBox x:Name="ThemeCombo" Margin="0,7,0,16"/>

      <CheckBox x:Name="StartupCheck" Content="Launch IssueDrop when I sign in to Windows" Margin="0,0,0,16"/>

      <TextBlock Text="Keep submitted history" FontWeight="SemiBold"/>
      <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
        <TextBox x:Name="RetentionBox" Style="{StaticResource ComposerTextBox}" Width="70" Background="{DynamicResource InputBackgroundBrush}" Padding="10,7"/>
        <TextBlock Text=" days" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource GhostButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
      <Button Style="{StaticResource PrimaryButton}" Content="Save settings" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
